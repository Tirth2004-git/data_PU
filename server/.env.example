PORT=5000
# MongoDB Connection String (Atlas M0 Free Tier or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campus_compass?retryWrites=true&w=majority
# Set to 'memory' to run an automatic in-memory MongoDB instance for local demonstration
MONGODB_URI=memory

# JWT Authentication Secret
JWT_SECRET=campus_compass_jwt_super_secret_key_2026_change_in_production

# JWT Expiration Duration
JWT_EXPIRES_IN=8h

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Site PIN Gate & Security Alerts
SITE_PIN_HASH=                 # bcrypt hash of the PIN, generated by setSitePin.js — never store the plain PIN
SITE_ACCESS_TOKEN_SECRET=      # separate random secret for signing the site-access JWT, different from JWT_SECRET
ALERT_EMAIL_TO=ozatirth52@gmail.com
ALERT_EMAIL_FROM=              # the Gmail address used to send alerts (can be the same or a separate account)
GMAIL_APP_PASSWORD=            # a Gmail "App Password" (free), not the real Gmail password — generated in the Google Account's security settings with 2-Step Verification on
